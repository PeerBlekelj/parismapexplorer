{
  "git": {
    "deploymentEnabled": false
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "parismapexplorer.vercel.app"
        }
      ],
      "destination": "https://paris1550.vercel.app/:path*",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/about/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/fr",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/fr/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/fr/:path*",
      "destination": "/:path*",
      "permanent": false
    },
    {
      "source": "/fr/:path*/",
      "destination": "/:path*/",
      "permanent": false
    },
    {
      "source": "/sv",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/sv/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/sv/:path*",
      "destination": "/:path*",
      "permanent": false
    },
    {
      "source": "/sv/:path*/",
      "destination": "/:path*/",
      "permanent": false
    }
  ]
}
